import streamlit as st
import streamlit.components.v1 as components

# Cấu hình trang Streamlit
st.set_page_config(
    page_title="Super Mario Bros Streamlit",
    page_icon="🍄",
    layout="centered"
)

st.title("🍄 Super Mario Bros - Streamlit Game")
st.write("Sử dụng các phím mũi tên **Trái / Phải** để di chuyển và phím **Lên / Space** để nhảy!")

# Mã HTML, CSS, JavaScript cho game Super Mario mini
mario_game_html = """
<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #5c94fc; /* Màu bầu trời Mario */
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Courier New', Courier, monospace;
        }
        #gameContainer {
            position: relative;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }
        canvas {
            background-color: #5c94fc;
            border: 4px solid #000;
            display: block;
        }
        #ui {
            position: absolute;
            top: 10px;
            left: 10px;
            color: white;
            font-size: 18px;
            font-weight: bold;
            text-shadow: 2px 2px #000;
        }
    </style>
</head>
<body>

<div id="gameContainer">
    <div id="ui">MARIO <br> SCORE: <span id="score">000000</span></div>
    <canvas id="gameCanvas" width="600" height="350"></canvas>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');

let score = 0;

// Trạng thái bàn phím
const keys = {
    right: false,
    left: false,
    up: false
};

document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'd') keys.right = true;
    if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = true;
    if (e.key === 'ArrowUp' || e.key === ' ' || e.key === 'w') {
        if (!keys.up && mario.grounded) {
            mario.vy = -mario.jumpPower;
            mario.grounded = false;
        }
        keys.up = true;
    }
});

document.addEventListener('keyup', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'd') keys.right = false;
    if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = false;
    if (e.key === 'ArrowUp' || e.key === ' ' || e.key === 'w') keys.up = false;
});

// Đối tượng Mario
const mario = {
    x: 50,
    y: 200,
    width: 24,
    height: 32,
    vx: 0,
    vy: 0,
    speed: 4,
    jumpPower: 11,
    gravity: 0.5,
    grounded: false,
    color: '#e52521'
};

// Đất & Khối gạch
const floorY = 300;
const blocks = [
    { x: 150, y: 200, w: 30, h: 30, type: 'question', active: true },
    { x: 180, y: 200, w: 30, h: 30, type: 'brick' },
    { x: 210, y: 200, w: 30, h: 30, type: 'question', active: true },
    { x: 240, y: 200, w: 30, h: 30, type: 'brick' },
    { x: 400, y: 160, w: 30, h: 30, type: 'question', active: true },
];

// Kẻ thù (Goomba)
const goombas = [
    { x: 320, y: floorY - 24, w: 24, h: 24, vx: -1, alive: true },
    { x: 500, y: floorY - 24, w: 24, h: 24, vx: -1, alive: true }
];

function update() {
    // Di chuyển ngang
    if (keys.right) mario.vx = mario.speed;
    else if (keys.left) mario.vx = -mario.speed;
    else mario.vx = 0;

    // Trọng lực
    mario.vy += mario.gravity;

    // Cập nhật vị trí
    mario.x += mario.vx;
    mario.y += mario.vy;

    // Giới hạn màn hình trái/phải
    if (mario.x < 0) mario.x = 0;
    if (mario.x + mario.width > canvas.width) mario.x = canvas.width - mario.width;

    // Va chạm mặt đất
    if (mario.y + mario.height >= floorY) {
        mario.y = floorY - mario.height;
        mario.vy = 0;
        mario.grounded = true;
    }

    // Va chạm gạch/khối hỏi chấm
    blocks.forEach(b => {
        if (mario.x < b.x + b.w && mario.x + mario.width > b.x &&
            mario.y < b.y + b.h && mario.y + mario.height > b.y) {
            // Va chạm từ dưới lên
            if (mario.vy < 0 && mario.y >= b.y + b.h - 10) {
                mario.vy = 0;
                mario.y = b.y + b.h;
                if (b.type === 'question' && b.active) {
                    b.active = false;
                    score += 200;
                    scoreEl.innerText = String(score).padStart(6, '0');
                }
            }
            // Đứng lên trên khối
            else if (mario.vy > 0 && mario.y + mario.height - mario.vy <= b.y) {
                mario.y = b.y - mario.height;
                mario.vy = 0;
                mario.grounded = true;
            }
        }
    });

    // Cập nhật Goomba
    goombas.forEach(g => {
        if (!g.alive) return;
        g.x += g.vx;

        if (g.x <= 0 || g.x + g.w >= canvas.width) g.vx *= -1;

        // Va chạm giữa Mario và Goomba
        if (mario.x < g.x + g.w && mario.x + mario.width > g.x &&
            mario.y < g.y + g.h && mario.y + mario.height > g.y) {
            
            // Giẫm lên đầu Goomba
            if (mario.vy > 0 && mario.y + mario.height - mario.vy <= g.y + 10) {
                g.alive = false;
                mario.vy = -6; // Nhảy nảy lên
                score += 100;
                scoreEl.innerText = String(score).padStart(6, '0');
            } else {
                // Thua game -> Reset vị trí
                mario.x = 50;
                mario.y = 200;
            }
        }
    });
}

function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Vẽ Đất
    ctx.fillStyle = '#c84c0c';
    ctx.fillRect(0, floorY, canvas.width, canvas.height - floorY);
    ctx.fillStyle = '#fcb470';
    ctx.fillRect(0, floorY, canvas.width, 4);

    // Vẽ Đám mây
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(100, 80, 20, 0, Math.PI * 2);
    ctx.arc(120, 70, 25, 0, Math.PI * 2);
    ctx.arc(140, 80, 20, 0, Math.PI * 2);
    ctx.fill();

    // Vẽ Núi bụi cây
    ctx.fillStyle = '#00a800';
    ctx.beginPath();
    ctx.arc(480, 300, 40, Math.PI, 0);
    ctx.fill();

    // Vẽ Khối Gạch
    blocks.forEach(b => {
        if (b.type === 'brick') {
            ctx.fillStyle = '#b84418';
            ctx.fillRect(b.x, b.y, b.w, b.h);
            ctx.strokeStyle = '#000';
            ctx.strokeRect(b.x, b.y, b.w, b.h);
        } else if (b.type === 'question') {
            ctx.fillStyle = b.active ? '#fcb42c' : '#8d8d8d';
            ctx.fillRect(b.x, b.y, b.w, b.h);
            ctx.strokeStyle = '#000';
            ctx.strokeRect(b.x, b.y, b.w, b.h);
            if (b.active) {
                ctx.fillStyle = '#000';
                ctx.font = 'bold 20px monospace';
                ctx.fillText('?', b.x + 9, b.y + 22);
            }
        }
    });

    // Vẽ Goomba
    goombas.forEach(g => {
        if (g.alive) {
            ctx.fillStyle = '#a84400';
            ctx.fillRect(g.x, g.y, g.w, g.h);
            // Mắt
            ctx.fillStyle = '#fff';
            ctx.fillRect(g.x + 4, g.y + 6, 4, 8);
            ctx.fillRect(g.x + 16, g.y + 6, 4, 8);
        }
    });

    // Vẽ Mario
    ctx.fillStyle = mario.color;
    ctx.fillRect(mario.x, mario.y, mario.width, mario.height);
    // Mũ Mario
    ctx.fillStyle = '#e52521';
    ctx.fillRect(mario.x, mario.y, mario.width + 4, 8);
    // Quần Mario
    ctx.fillStyle = '#00249c';
    ctx.fillRect(mario.x + 4, mario.y + 16, 16, 12);
}

function loop() {
    update();
    draw();
    requestAnimationFrame(loop);
}

loop();
</script>
</body>
</html>
"""

# Hiển thị Game lên Streamlit
components.html(mario_game_html, height=420)
